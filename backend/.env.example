# READORA Backend Environment Variables Template
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/readora?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
FRONTEND_URL=https://your-readora-frontend.vercel.app

# Optional Email Service Configuration (Defaults to in-memory dispatch logging)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="READORA Team <noreply@readora.com>"
